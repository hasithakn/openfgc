{
	"info": {
		"_postman_id": "enf-api-collection",
		"name": "WSO2 DPDP Event Notification Framework (ENF)",
		"description": "Postman collection for testing WSO2 DPDP ENF JAX-RS Endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "orgId",
			"value": "org-001",
			"type": "string"
		},
		{
			"key": "groupId",
			"value": "group-001",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Topics",
			"item": [
				{
					"name": "Create Topic",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "org-id",
								"value": "{{orgId}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"user-consent-events\",\n  \"description\": \"Topic for user consent updates\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/topics",
							"host": ["{{baseUrl}}"],
							"path": ["topics"]
						}
					}
				},
				{
					"name": "List Topics",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "org-id",
								"value": "{{orgId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/topics?status=ACTIVE&limit=10&offset=0",
							"host": ["{{baseUrl}}"],
							"path": ["topics"],
							"query": [
								{ "key": "status", "value": "ACTIVE" },
								{ "key": "limit", "value": "10" },
								{ "key": "offset", "value": "0" }
							]
						}
					}
				},
				{
					"name": "Delete Topic",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "org-id",
								"value": "{{orgId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/topics/:topicId",
							"host": ["{{baseUrl}}"],
							"path": ["topics", ":topicId"],
							"variable": [
								{ "key": "topicId", "value": "topic-123" }
							]
						}
					}
				}
			]
		},
		{
			"name": "Subscriptions",
			"item": [
				{
					"name": "Create Subscription",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "org-id",
								"value": "{{orgId}}"
							},
							{
								"key": "group-id",
								"value": "{{groupId}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"topic\": \"user-consent-events\",\n    \"filter\": {\n      \"type\": \"specific\",\n      \"purposes\": [\"MARKETING\"]\n    },\n    \"delivery\": {\n      \"mode\": \"webhook\",\n      \"callbackUrl\": \"http://localhost:9091/webhook\",\n      \"sharedSecret\": \"a-shared-secret-value\"\n    }\n  }"
						},
						"url": {
							"raw": "{{baseUrl}}/subscriptions",
							"host": ["{{baseUrl}}"],
							"path": ["subscriptions"]
						}
					}
				},
				{
					"name": "List Subscriptions",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "org-id",
								"value": "{{orgId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/subscriptions?status=ACTIVE&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["subscriptions"],
							"query": [
								{ "key": "status", "value": "ACTIVE" },
								{ "key": "limit", "value": "10" }
							]
						}
					}
				},
				{
					"name": "Get Subscription by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "org-id",
								"value": "{{orgId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/subscriptions/:subscriptionId",
							"host": ["{{baseUrl}}"],
							"path": ["subscriptions", ":subscriptionId"],
							"variable": [
								{ "key": "subscriptionId", "value": "sub-123" }
							]
						}
					}
				},
				{
					"name": "Delete Subscription",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "org-id",
								"value": "{{orgId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/subscriptions/:subscriptionId",
							"host": ["{{baseUrl}}"],
							"path": ["subscriptions", ":subscriptionId"],
							"variable": [
								{ "key": "subscriptionId", "value": "sub-123" }
							]
						}
					}
				},
				{
					"name": "List Subscription Events",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "org-id",
								"value": "{{orgId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/subscriptions/:subscriptionId/events?limit=10&offset=0",
							"host": ["{{baseUrl}}"],
							"path": ["subscriptions", ":subscriptionId", "events"],
							"query": [
								{ "key": "limit", "value": "10" },
								{ "key": "offset", "value": "0" }
							],
							"variable": [
								{ "key": "subscriptionId", "value": "sub-123" }
							]
						}
					}
				},
				{
					"name": "Get Subscription Event Delivery History",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "org-id",
								"value": "{{orgId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/subscriptions/:subscriptionId/events/:deliveryId/history",
							"host": ["{{baseUrl}}"],
							"path": ["subscriptions", ":subscriptionId", "events", ":deliveryId", "history"],
							"variable": [
								{ "key": "subscriptionId", "value": "sub-123" },
								{ "key": "deliveryId", "value": "deliv-123" }
							]
						}
					}
				},
				{
					"name": "Get Subscription Event Delivery History (Alias)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "org-id",
								"value": "{{orgId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/subscriptions/:subscriptionId/events/:deliveryId",
							"host": ["{{baseUrl}}"],
							"path": ["subscriptions", ":subscriptionId", "events", ":deliveryId"],
							"variable": [
								{ "key": "subscriptionId", "value": "sub-123" },
								{ "key": "deliveryId", "value": "deliv-123" }
							]
						},
						"description": "Alias of \"Get Subscription Event Delivery History\" — same handler, shorter path without the trailing /history segment."
					}
				}
			]
		},
		{
			"name": "Events",
			"item": [
				{
					"name": "Publish Event",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "org-id",
								"value": "{{orgId}}"
							},
							{
								"key": "group-id",
								"value": "{{groupId}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"topic\": \"user-consent-events\",\n  \"purposes\": [\"MARKETING\"],\n  \"payload\": {\n    \"userId\": \"user-1001\",\n    \"consentGiven\": false\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/events",
							"host": ["{{baseUrl}}"],
							"path": ["events"]
						}
					}
				},
				{
					"name": "List Events",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "org-id",
								"value": "{{orgId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/events?limit=10&offset=0",
							"host": ["{{baseUrl}}"],
							"path": ["events"],
							"query": [
								{ "key": "status", "value": "", "disabled": true },
								{ "key": "subscriptionId", "value": "", "disabled": true },
								{ "key": "purposes", "value": "", "disabled": true },
								{ "key": "search", "value": "", "disabled": true },
								{ "key": "limit", "value": "10" },
								{ "key": "offset", "value": "0" }
							]
						}
					}
				},
				{
					"name": "Get Event Delivery History",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "org-id",
								"value": "{{orgId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/events/:deliveryId/history",
							"host": ["{{baseUrl}}"],
							"path": ["events", ":deliveryId", "history"],
							"variable": [
								{ "key": "deliveryId", "value": "deliv-123" }
							]
						}
					}
				},
				{
					"name": "Get Event Delivery History (Alias)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "org-id",
								"value": "{{orgId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/events/:deliveryId",
							"host": ["{{baseUrl}}"],
							"path": ["events", ":deliveryId"],
							"variable": [
								{ "key": "deliveryId", "value": "deliv-123" }
							]
						},
						"description": "Alias of \"Get Event Delivery History\" — same handler, shorter path without the trailing /history segment."
					}
				},
				{
					"name": "Poll Events",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "org-id",
								"value": "{{orgId}}"
							},
							{
								"key": "group-id",
								"value": "{{groupId}}"
							},
							{
								"key": "X-Event-Signature",
								"value": "sample-signature-hash"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"returnImmediately\": true,\n  \"maxEvents\": 10\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/events/poll",
							"host": ["{{baseUrl}}"],
							"path": ["events", "poll"]
						}
					}
				},
				{
					"name": "Submit Delivery Completion (ACK)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "org-id",
								"value": "{{orgId}}"
							},
							{
								"key": "group-id",
								"value": "{{groupId}}"
							},
							{
								"key": "X-Event-Signature",
								"value": "sample-signature-hash"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"completionStatus\": \"ACK\",\n  \"completionEvidence\": \"Processed successfully\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/deliveries/:deliveryId/completion",
							"host": ["{{baseUrl}}"],
							"path": ["deliveries", ":deliveryId", "completion"],
							"variable": [
								{ "key": "deliveryId", "value": "deliv-123" }
							]
						}
					}
				}
			]
		}
	]
}
